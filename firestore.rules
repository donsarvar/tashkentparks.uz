rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "salimovsarvar21@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Public tour content: anyone can read, only admin can write
    match /parks/{parkId} {
      allow read: if true;
      allow write: if isAdmin();
      match /scenes/{sceneId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Registered users: each user writes only their own profile, admin reads all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    match /users/{document=**} {
      allow list: if isAdmin();
    }

    // Visit analytics: signed-in users log their own sessions, admin reads
    match /activity_logs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
